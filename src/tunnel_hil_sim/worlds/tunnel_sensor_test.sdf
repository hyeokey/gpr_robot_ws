      <link name="sleeper_10"><pose>11.4 0 0.22 0 0 0</pose><visual name="v"><geometry><box><size>0.24 2.4 0.16</size></box></geometry><material><diffuse>0.30 0.23 0.16 1</diffuse></material></visual></link>
