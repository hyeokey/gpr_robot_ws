      <link name="sleeper_15"><pose>17.4 0 0.22 0 0 0</pose><visual name="v"><geometry><box><size>0.24 2.4 0.16</size></box></geometry><material><diffuse>0.30 0.23 0.16 1</diffuse></material></visual></link>
      <link name="sleeper_16"><pose>18.6 0 0.22 0 0 0</pose><visual name="v"><geometry><box><size>0.24 2.4 0.16</size></box></geometry><material><diffuse>0.30 0.23 0.16 1</diffuse></material></visual></link>
    </model>

    <!-- Fixed phase-1 plate; both sensors face the +Y inspection panel. -->
    <model name="dual_lidar_rig">
      <static>true</static>
      <link name="rig_body"><pose>2.5 0 1.25 0 0 0</pose><visual name="visual"><geometry><box><size>0.65 0.10 0.28</size></box></geometry><material><diffuse>0.93 0.48 0.10 1</diffuse></material></visual></link>
      <link name="lidar_1_link">
        <pose>2.75 0 1.25 0 0 1.570796</pose><visual name="body"><geometry><box><size>0.06 0.05 0.05</size></box></geometry><material><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
        <sensor name="lidar_1" type="gpu_lidar"><topic>/sim/lidar_1/scan</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize><ray><scan><horizontal><samples>181</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.436332</max_angle></horizontal><vertical><samples>81</samples><resolution>1</resolution><min_angle>-0.349066</min_angle><max_angle>0.349066</max_angle></vertical></scan><range><min>0.05</min><max>8.0</max><resolution>0.005</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise></ray></sensor>
      </link>
      <link name="lidar_2_link">
        <pose>2.25 0 1.25 0 0 1.570796</pose><visual name="body"><geometry><box><size>0.06 0.05 0.05</size></box></geometry><material><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
        <sensor name="lidar_2" type="gpu_lidar"><topic>/sim/lidar_2/scan</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize><ray><scan><horizontal><samples>181</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.436332</max_angle></horizontal><vertical><samples>81</samples><resolution>1</resolution><min_angle>-0.349066</min_angle><max_angle>0.349066</max_angle></vertical></scan><range><min>0.05</min><max>8.0</max><resolution>0.005</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise></ray></sensor>
      </link>
    </model>

