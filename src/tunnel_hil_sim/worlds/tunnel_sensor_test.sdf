      <link name="arch_12"><pose>10 -2.6169 6.1887 3.828816 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.41 0.42 0.43 1</diffuse></material></visual></link>
