<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="subway_tunnel_hil">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.08 0.08 0.09 1</ambient><background>0.015 0.018 0.022 1</background><shadows>true</shadows></scene>

    <!-- 8 m clear arch span, 4 m radius, 3 m side walls, 20 m length. -->
    <model name="subway_tunnel_shell">
      <static>true</static>
      <link name="floor"><pose>10 0 -0.125 0 0 0</pose><collision name="collision"><geometry><box><size>20 8.25 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 8.25 0.25</size></box></geometry><material><ambient>0.20 0.20 0.21 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material></visual></link>
      <link name="right_straight_wall"><pose>10 4.125 1.5 0 0 0</pose><collision name="collision"><geometry><box><size>20 0.25 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.25 3.0</size></box></geometry><material><ambient>0.34 0.35 0.36 1</ambient><diffuse>0.43 0.44 0.45 1</diffuse></material></visual></link>
      <link name="left_straight_wall"><pose>10 -4.125 1.5 0 0 0</pose><collision name="collision"><geometry><box><size>20 0.25 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.25 3.0</size></box></geometry><material><ambient>0.34 0.35 0.36 1</ambient><diffuse>0.43 0.44 0.45 1</diffuse></material></visual></link>

      <!-- Sixteen collision-backed facets approximate the concrete arch. -->
      <link name="arch_01"><pose>10 4.1051 3.4043 1.668971 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.31 0.32 0.33 1</ambient><diffuse>0.40 0.41 0.42 1</diffuse></material></visual></link>
      <link name="arch_02"><pose>10 3.9474 4.1974 1.865321 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.41 0.42 0.43 1</diffuse></material></visual></link>
      <link name="arch_03"><pose>10 3.6379 4.9445 2.061670 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.31 0.32 0.33 1</ambient><diffuse>0.40 0.41 0.42 1</diffuse></material></visual></link>
      <link name="arch_04"><pose>10 3.1887 5.6169 2.258020 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.41 0.42 0.43 1</diffuse></material></visual></link>
