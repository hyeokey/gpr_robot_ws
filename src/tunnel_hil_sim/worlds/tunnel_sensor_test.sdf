      <link name="arch_14"><pose>10 -3.6379 4.9445 4.221515 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.41 0.42 0.43 1</diffuse></material></visual></link>
      <link name="arch_15"><pose>10 -3.9474 4.1974 4.417865 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.31 0.32 0.33 1</ambient><diffuse>0.40 0.41 0.42 1</diffuse></material></visual></link>
      <link name="arch_16"><pose>10 -4.1051 3.4043 4.614214 0 0</pose><collision name="collision"><geometry><box><size>20 0.82 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.82 0.25</size></box></geometry><material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.41 0.42 0.43 1</diffuse></material></visual></link>

      <!-- Flush wall target for repeatable RANSAC/SVD tests. -->
      <link name="inspection_panel"><pose>2.5 3.97 1.55 0 0 0</pose><collision name="collision"><geometry><box><size>2.0 0.04 2.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 0.04 2.1</size></box></geometry><material><ambient>0.52 0.48 0.39 1</ambient><diffuse>0.60 0.56 0.47 1</diffuse></material></visual></link>
    </model>

    <model name="track">
      <static>true</static>
      <link name="ballast"><pose>10 0 0.10 0 0 0</pose><collision name="collision"><geometry><box><size>20 3.2 0.20</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 3.2 0.20</size></box></geometry><material><ambient>0.16 0.15 0.14 1</ambient><diffuse>0.23 0.22 0.20 1</diffuse></material></visual></link>
      <link name="rail_right"><pose>10 0.76 0.31 0 0 0</pose><collision name="collision"><geometry><box><size>20 0.075 0.14</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.075 0.14</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.42 0.44 0.47 1</diffuse></material></visual></link>
      <link name="rail_left"><pose>10 -0.76 0.31 0 0 0</pose><collision name="collision"><geometry><box><size>20 0.075 0.14</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.075 0.14</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.42 0.44 0.47 1</diffuse></material></visual></link>
      <link name="sleeper_01"><pose>0.6 0 0.22 0 0 0</pose><visual name="v"><geometry><box><size>0.24 2.4 0.16</size></box></geometry><material><diffuse>0.30 0.23 0.16 1</diffuse></material></visual></link>
      <link name="sleeper_02"><pose>1.8 0 0.22 0 0 0</pose><visual name="v"><geometry><box><size>0.24 2.4 0.16</size></box></geometry><material><diffuse>0.30 0.23 0.16 1</diffuse></material></visual></link>
