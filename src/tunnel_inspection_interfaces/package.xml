<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunnel_inspection_interfaces</name>
  <version>0.1.0</version>
  <description>
    다구간 터널 검사 자동 순회(tunnel_inspection_planner)의 검출기->시퀀서 전용 메시지.
    기존 /piper/locked_wall_plane(PoseStamped, 단일-벽 수동 워크플로우 전용)은 그대로 두고,
    자동 순회 모드에서만 쓰는 구간 ID 포함 메시지를 별도로 정의한다.
  </description>
  <maintainer email="msol62@krri.re.kr">hyeokey</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rosidl_default_generators</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
